{
  "name": "logify",
  "displayName": "Logify",
  "description": "Quickly insert colourful and deep-inspection console.dir statements in JavaScript.",
  "icon": "images/logify-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rvsiyad/logify.git"
  },
  "version": "0.0.1",
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "console",
    "log",
    "debug",
    "dir",
    "JavaScript",
    "colors"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [],
  "main": "./src/extension.js",
  "scripts": {
    "lint": "eslint .",
    "test": "vscode-test"
  },
  "contributes": {
    "commands": [
      {
        "command": "logify.addConsole",
        "title": "Logify: Add Console Dir"
      },
      {
        "command": "logify.toggleShowVariableNameLog",
        "title": "Logify: Toggle Descriptive Console Log"
      }
    ],
    "configuration": {
      "title": "Logify settings",
      "properties": {
        "logify.enableDescriptiveLogging": {
          "type": "boolean",
          "default": false,
          "description": "Include a descriptive console.log with the variable name before the console.dir call."
        }
      }
    },
    "keybindings": [
      {
        "command": "logify.addConsole",
        "key": "ctrl+alt+l",
        "mac": "ctrl+alt+l",
        "when": "editorTextFocus && !editorReadonly"
      }
    ]
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0"
  },
  "dependencies": {
    "camelcase": "^6.3.0"
  }
}